import wollok.game.*
import nivel1.mobs.*
import direcciones.*

describe "test policia" {

    test "Cuando el policia se mueve avanza una posicion hacia arriba" {
        policia.position(game.at(19, 1))

        policia.moverse()

        assert.equals(2, policia.position().y())
    }

    test "Cuando el policia llega al limite superior comienza a bajar" {
        policia.position(game.at(19, 6))

        policia.moverse()

        assert.equals(5, policia.position().y())
    }

    test "Cuando el policia se mueve mantiene su posicion en x" {
        policia.position(game.at(19, 1))

        policia.moverse()

        assert.equals(19, policia.position().x())
    }
    
     test "Cuando el policia llega al limite inferior cambia el sentido para volver a subir" {
        policia.position(game.at(19, 0))
        policia.moverse()
        assert.equals(1, policia.position().y())
    }
    
}

describe "Nuevos tests para Policía" {
    test "La imagen asignada a la entidad policía es 'policia.png'" {
        assert.equals("policia.png", policia.image())
    }

    test "El policía reporta correctamente su coordenada actual en el eje Y" {
        policia.position(game.at(19, 5))
        assert.equals(5, policia.coordenadaActual())
    }

    test "Las direcciones de límite máximo y mínimo del policía están configuradas hacia arriba y abajo respectivamente" {
        assert.equals(arriba, policia.direccionHaciaMaximo())
        assert.equals(abajo, policia.direccionHaciaMinimo())
    }

    test "El policía al encontrarse en el límite inferior y moverse hacia abajo invierte su sentido para ascender" {
        policia.position(game.at(19, 0))
        policia.direccion(abajo)
        policia.moverse()
        assert.equals(1, policia.position().y())
    }
}