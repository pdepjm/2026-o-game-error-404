import wollok.game.*
import alumno.*
import efectos.*
import nivel1.consumibles.*
import nivel1.bondi.*
import nivel1.mobs.*
import nivel1.nivel1.*
import direcciones.*

describe "Mobs y la interacción con alumno" {
    test "Cuando el fisura choca con el alumno le saca 15 de tiempo y la mitad de la plata" {
        lucio.conseguirDinero(500 - lucio.dinero())
        if (lucio.tiempo() < 50) {
            lucio.agregarTiempo(50 - lucio.tiempo())
        } else if (lucio.tiempo() > 50) {
            lucio.consumirTiempo(lucio.tiempo() - 50)
        }
        
        fisura.interactuar(lucio)

        assert.equals(250, lucio.dinero())
        assert.equals(35, lucio.tiempo())
    }

    test "Cuando el vecino choca con el alumno le suma 5 de tiempo" {
        if (lucio.tiempo() < 50) {
            lucio.agregarTiempo(50 - lucio.tiempo())
        } else if (lucio.tiempo() > 50) {
            lucio.consumirTiempo(lucio.tiempo() - 50)
        }
        
        vecino.interactuar(lucio)

        assert.equals(55, lucio.tiempo())
    }

    test "El fisura se mueve hacia la derecha en su rango" {
        fisura.position(game.at(7, 10))
        fisura.direccion(derecha)
        fisura.moverse()
        assert.equals(8, fisura.position().x())
    }

    test "El fisura cambia de sentido hacia la izquierda al llegar a su limite maximo" {
        fisura.position(game.at(12, 10))
        fisura.moverse()
        assert.equals(11, fisura.position().x())
    }

    test "El kiosco le carga SUBE al alumno si tiene mas de 500 de dinero" {
        lucio.asignarSube(sube)
        lucio.conseguirDinero(1000 - lucio.dinero())
        const saldoAnterior = lucio.saldo()
        kiosco.interactuar(lucio)
        assert.equals(saldoAnterior + 500, lucio.saldo())
        assert.equals(500, lucio.dinero())
    }
}

describe "Nuevos tests para Mobs y Consumibles de Nivel 1" {
    test "El billete de 500 incrementa el dinero del alumno en 500 unidades" {
        const dineroAntes = lucio.dinero()
        billete500.interactuar(lucio)
        assert.equals(dineroAntes + 500, lucio.dinero())
    }

    test "El auto rojo se desplaza horizontalmente y reinicia su posición a 0 al llegar al ancho del juego" {
        autoRojo.position(game.at(game.width() - 1, 8))
        autoRojo.moverse()
        assert.equals(0, autoRojo.position().x())
    }

    test "El kiosco no realiza la recarga de SUBE si el alumno no posee una tarjeta asignada" {
        lucio.asignarSube(null)
        lucio.conseguirDinero(1000 - lucio.dinero())
        const dineroAntes = lucio.dinero()
        kiosco.interactuar(lucio)
        assert.notThat(lucio.tieneSube())
        assert.equals(dineroAntes, lucio.dinero())
    }

    test "El kiosco no recarga la SUBE si el alumno tiene la tarjeta pero menos de 500 de dinero" {
        lucio.asignarSube(sube)
        lucio.pierdeDinero(lucio.dinero())
        lucio.conseguirDinero(150) // Menor a 500
        const saldoAnterior = lucio.saldo()
        kiosco.interactuar(lucio)
        assert.equals(saldoAnterior, lucio.saldo())
        assert.equals(150, lucio.dinero())
    }

}