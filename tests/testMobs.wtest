import wollok.game.*
import alumno.*
import efectos.*
import nivel1.consumibles.*
import nivel1.bondi.*
import nivel1.mobs.*
import nivel1.nivel1.*
import direcciones.*
import nivel2.mobsNivel2.*
import nivel2.nivel2.*
import nivel3.mobsNivel3.*
import nivel3.nivel3.*

describe "Mobs y la interacción con alumno" {
    test "Cuando el fisura choca con el alumno le saca 15 de tiempo y la mitad de la plata" {
        lucio.conseguirDinero(500 - lucio.dinero())
        if (lucio.tiempo() < 50) {
            lucio.agregarTiempo(50 - lucio.tiempo())
        } else if (lucio.tiempo() > 50) {
            lucio.consumirTiempo(lucio.tiempo() - 50)
        }
        
        fisura.interactuar(lucio)

        assert.equals(250, lucio.dinero())
        assert.equals(35, lucio.tiempo())
    }

    test "Cuando el vecino choca con el alumno le suma 5 de tiempo" {
        if (lucio.tiempo() < 50) {
            lucio.agregarTiempo(50 - lucio.tiempo())
        } else if (lucio.tiempo() > 50) {
            lucio.consumirTiempo(lucio.tiempo() - 50)
        }
        
        vecino.interactuar(lucio)

        assert.equals(55, lucio.tiempo())
    }

    test "El fisura se mueve hacia la derecha en su rango" {
        fisura.position(game.at(7, 10))
        fisura.direccion(derecha)
        fisura.moverse()
        assert.equals(8, fisura.position().x())
    }

    test "El fisura cambia de sentido hacia la izquierda al llegar a su limite maximo" {
        fisura.position(game.at(12, 10))
        fisura.moverse()
        assert.equals(11, fisura.position().x())
    }

    test "El kiosco le carga SUBE al alumno si tiene mas de 500 de dinero" {
        lucio.asignarSube(conSube)
        lucio.conseguirDinero(1000 - lucio.dinero())
        const saldoAnterior = lucio.saldo()
        kiosco.interactuar(lucio)
        assert.equals(saldoAnterior + 500, lucio.saldo())
        assert.equals(500, lucio.dinero())
    }
}

describe "Nuevos tests para Mobs y Consumibles de Nivel 1" {
    test "El billete de 500 incrementa el dinero del alumno en 500 unidades" {
        const dineroAntes = lucio.dinero()
        billete500.interactuar(lucio)
        assert.equals(dineroAntes + 500, lucio.dinero())
    }

    test "El auto rojo se desplaza horizontalmente y reinicia su posición a 0 al llegar al ancho del juego" {
        autoRojo.position(game.at(game.width() - 1, 8))
        autoRojo.moverse()
        assert.equals(0, autoRojo.position().x())
    }

    test "El kiosco no realiza la recarga de SUBE si el alumno no posee una tarjeta asignada" {
        lucio.asignarSube(sinSube)
        lucio.conseguirDinero(1000 - lucio.dinero())
        const dineroAntes = lucio.dinero()
        kiosco.interactuar(lucio)
        assert.notThat(lucio.tieneSube())
        assert.equals(dineroAntes, lucio.dinero())
    }

    test "El kiosco no recarga la SUBE si el alumno tiene la tarjeta pero menos de 500 de dinero" {
        lucio.asignarSube(conSube)
        lucio.pierdeDinero(lucio.dinero())
        lucio.conseguirDinero(150) // Menor a 500
        const saldoAnterior = lucio.saldo()
        kiosco.interactuar(lucio)
        assert.equals(saldoAnterior, lucio.saldo())
        assert.equals(150, lucio.dinero())
    }

}

describe "Mobs de Nivel 1 con alumnos independientes" {
    test "El fisura roba la mitad del dinero y resta 15 segundos" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 500,
            tiempoInicial = 50,
            danoAlumno = 1
        )

        fisura.interactuar(alumnoPrueba)

        assert.equals(250, alumnoPrueba.dinero())
        assert.equals(35, alumnoPrueba.tiempo())
    }

    test "El vecino agrega cinco segundos al alumno" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 0,
            tiempoInicial = 20,
            danoAlumno = 1
        )

        vecino.interactuar(alumnoPrueba)

        assert.equals(25, alumnoPrueba.tiempo())
    }

    test "El kiosco carga 500 en la SUBE y cobra 500 si el alumno puede pagarlo" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 700,
            tiempoInicial = 20,
            danoAlumno = 1
        )
        alumnoPrueba.asignarSube(conSube)
        alumnoPrueba.sube().saldo(100)

        kiosco.interactuar(alumnoPrueba)

        assert.equals(200, alumnoPrueba.dinero())
        assert.equals(600, alumnoPrueba.saldo())
    }

    test "Un auto atropella al alumno, le resta tiempo y dinero, y lo devuelve al inicio" {
        const autoPrueba = new Auto(
            position = game.at(8, 8),
            carrilY = 8,
            image = "rojo.png"
        )
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 80,
            tiempoInicial = 10,
            danoAlumno = 1
        )
        alumnoPrueba.position(game.at(8, 8))

        autoPrueba.interactuar(alumnoPrueba)

        assert.equals(0, alumnoPrueba.tiempo())
        assert.equals(0, alumnoPrueba.dinero())
        assert.equals(0, alumnoPrueba.position().x())
        assert.equals(0, alumnoPrueba.position().y())
    }

    test "El auto avanza una casilla y conserva su carril" {
        const autoPrueba = new Auto(
            position = game.at(3, 7),
            carrilY = 7,
            image = "taxi.png"
        )

        autoPrueba.moverse()

        assert.equals(4, autoPrueba.position().x())
        assert.equals(7, autoPrueba.position().y())
    }
}

describe "Mobs de los niveles siguientes" {
    test "La nube baja y vuelve a aparecer en la parte superior de su recorrido" {
        const posicionInicial = nube1.position()
        nube1.position(game.at(8, 6))

        nube1.moverse()
        const posicionLuegoDeBajar = nube1.position()

        nube1.moverse()
        const posicionLuegoDeReaparecer = nube1.position()
        nube1.position(posicionInicial)

        assert.equals(5, posicionLuegoDeBajar.y())
        assert.equals(11, posicionLuegoDeReaparecer.y())
    }

    test "La nube aumenta el sueño del alumno" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 0,
            tiempoInicial = 20,
            danoAlumno = 1
        )

        nube1.interactuar(alumnoPrueba)

        assert.equals(25, alumnoPrueba.sueno())
    }

}