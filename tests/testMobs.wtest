import wollok.game.*
import alumno.*
import efectos.*
import nivel1.consumibles.*
import nivel1.bondi.*
import nivel1.mobs.*
import nivel1.nivel1.*
import direcciones.*

describe "Nuevos tests para Mobs y Consumibles de Nivel 1" {
    test "El billete de 500 incrementa el dinero del alumno en 500 unidades" {
        const dineroAntes = lucio.dinero()
        billete500.interactuar(lucio)
        assert.equals(dineroAntes + 500, lucio.dinero())
    }

    test "El auto rojo se desplaza horizontalmente y reinicia su posición a 0 al llegar al ancho del juego" {
        autoRojo.position(game.at(game.width() - 1, 8))
        autoRojo.moverse()
        assert.equals(0, autoRojo.position().x())
    }

    test "El kiosco no realiza la recarga de SUBE si el alumno no posee una tarjeta asignada" {
        lucio.asignarSube(null)
        lucio.conseguirDinero(1000 - lucio.dinero())
        const dineroAntes = lucio.dinero()
        kiosco.interactuar(lucio)
        assert.notThat(lucio.tieneSube())
        assert.equals(dineroAntes, lucio.dinero())
    }

    test "El kiosco no recarga la SUBE si el alumno tiene la tarjeta pero menos de 500 de dinero" {
        lucio.asignarSube(sube)
        lucio.pierdeDinero(lucio.dinero())
        lucio.conseguirDinero(150) // Menor a 500
        const saldoAnterior = lucio.saldo()
        kiosco.interactuar(lucio)
        assert.equals(saldoAnterior, lucio.saldo())
        assert.equals(150, lucio.dinero())
    }

    test "La frase que emite el vecino al interactuar es exactamente 'Tomá, un café'" {
        assert.equals("Tomá, un café", vecino.frase())
    }
}