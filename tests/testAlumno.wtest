import alumno.*
import efectos.*
import interfaz.mostrables.*
import nivel1.consumibles.*
import nivel1.bondi.*
import nivel1.mobs.*
import nivel1.nivel1.*

describe "Alumno y sus Consumibles" {
    test "El alumno suma 100 de dinero al interactuar con un billete de 100" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)
        
        alumnoPrueba.pierdeDinero(alumnoPrueba.dinero()) 
        assert.equals(0, alumnoPrueba.dinero())

        game.addVisual(billete100)
        billete100.interactuar(alumnoPrueba)

        assert.equals(100, alumnoPrueba.dinero())
        
    }

    test "El alumno agarra la SUBE y revisa que la tiene" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)

        assert.notThat(alumnoPrueba.tieneSube())

        conSube.interactuar(alumnoPrueba)

        assert.that(alumnoPrueba.tieneSube())
    }

    test "Si no tiene saldo suficiente no puede subir al bondi" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)

        alumnoPrueba.asignarSube(conSube)
        assert.notThat(alumnoPrueba.subirAlBondi())
    }

    test "Si tiene saldo suficiente puede subir al bondi" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)

        alumnoPrueba.asignarSube(conSube)
        alumnoPrueba.conseguirDinero(10000)
        alumnoPrueba.sube().cargar(3000)
        assert.that(alumnoPrueba.subirAlBondi())
    }
    
    test "El tiempo del alumno se reduce correctamente al consumirlo" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)

        const tiempoInicial = alumnoPrueba.tiempo()
        alumnoPrueba.consumirTiempo(15)
        assert.equals(tiempoInicial - 15, alumnoPrueba.tiempo())
    }
    
    test "Pierde dinero de manera correcta sin bajar de cero" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)
        
        alumnoPrueba.pierdeDinero(alumnoPrueba.dinero()) 
        alumnoPrueba.conseguirDinero(50)
        alumnoPrueba.pierdeDinero(100)
        assert.equals(0, alumnoPrueba.dinero())
    }   

}

describe "Nuevos tests para Alumno" {
    test "El alumno aumenta su tiempo correctamente con agregarTiempo" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)
        
        const tiempoAnterior = alumnoPrueba.tiempo()
        alumnoPrueba.agregarTiempo(20)
        assert.equals(tiempoAnterior + 20, alumnoPrueba.tiempo())
    }

    test "El alumno aumenta y reduce su sueño correctamente dentro de los límites de 0 a 100" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)
        
        alumnoPrueba.reducirSueno(alumnoPrueba.sueno())
        assert.equals(0, alumnoPrueba.sueno())
        
        alumnoPrueba.aumentarSueno(50)
        assert.equals(50, alumnoPrueba.sueno())
        
        alumnoPrueba.reducirSueno(80) // No debe bajar de 0
        assert.equals(0, alumnoPrueba.sueno())

        alumnoPrueba.aumentarSueno(150) // No debe superar 50
        assert.equals(50, alumnoPrueba.sueno())
    }

    test "El alumno consigue dinero incrementando correctamente su monto actual" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)
        
        const dineroInicial = alumnoPrueba.dinero()
        alumnoPrueba.conseguirDinero(450)
        assert.equals(dineroInicial + 450, alumnoPrueba.dinero())
    }

    test "El alumno tiene el daño configurado correctamente según el personaje elegido (lucio = 13)" {     
        assert.equals(13, lucio.danoAlumno())
    }


    test "Si el alumno no tiene SUBE, subir al bondi retorna false" {
        const alumnoPrueba = new Alumno(imagenMenu = "_", imagen = "_", dineroInicial = 100, tiempoInicial = 60, danoAlumno = 60)
        
        alumnoPrueba.asignarSube(sinSube)
        assert.notThat(alumnoPrueba.subirAlBondi())
    }

}

describe "Estado y límites de Alumno" {
    test "El alumno conserva los valores configurados al crearse" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 250,
            tiempoInicial = 40,
            danoAlumno = 7
        )

        assert.equals(250, alumnoPrueba.dinero())
        assert.equals(40, alumnoPrueba.tiempo())
        assert.equals(7, alumnoPrueba.danoAlumno())
        assert.equals("juego.png", alumnoPrueba.image())
        assert.equals("menu.png", alumnoPrueba.imagenMenu())
        assert.equals(0, alumnoPrueba.sueno())
        assert.notThat(alumnoPrueba.tieneSube())
    }

    test "El tiempo no puede quedar por debajo de cero y pasar un segundo lo reduce en uno" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 0,
            tiempoInicial = 10,
            danoAlumno = 1
        )

        alumnoPrueba.consumirTiempo(15)
        assert.equals(0, alumnoPrueba.tiempo())

        alumnoPrueba.agregarTiempo(3)
        alumnoPrueba.pasarSegundo()
        assert.equals(2, alumnoPrueba.tiempo())

        alumnoPrueba.pasarSegundo()
        alumnoPrueba.pasarSegundo()
        assert.equals(0, alumnoPrueba.tiempo())
    }

    test "Pagar descuenta dinero sin permitir saldo negativo" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 100,
            tiempoInicial = 10,
            danoAlumno = 1
        )

        alumnoPrueba.pagar(35)
        assert.equals(65, alumnoPrueba.dinero())

        alumnoPrueba.pagar(100)
        assert.equals(0, alumnoPrueba.dinero())
    }

    test "El saldo es cero sin SUBE y refleja el saldo de la tarjeta al asignarla" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 0,
            tiempoInicial = 10,
            danoAlumno = 1
        )

        assert.equals(0, alumnoPrueba.saldo())
        alumnoPrueba.asignarSube(conSube)

        assert.that(alumnoPrueba.tieneSube())
        assert.equals(conSube.saldo(), alumnoPrueba.saldo())
    }

    test "Reiniciar restaura el estado inicial del alumno" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 250,
            tiempoInicial = 40,
            danoAlumno = 1
        )

        alumnoPrueba.conseguirDinero(100)
        alumnoPrueba.consumirTiempo(10)
        alumnoPrueba.aumentarSueno(30)
        alumnoPrueba.asignarSube(conSube)
        alumnoPrueba.position(game.at(5, 5))

        alumnoPrueba.reiniciar()

        assert.equals(250, alumnoPrueba.dinero())
        assert.equals(40, alumnoPrueba.tiempo())
        assert.equals(0, alumnoPrueba.sueno())
        assert.notThat(alumnoPrueba.tieneSube())
        assert.equals(0, alumnoPrueba.position().x())
        assert.equals(0, alumnoPrueba.position().y())
    }

    test "Las posiciones fuera del mapa no son válidas" {
        const alumnoPrueba = new Alumno(
            imagenMenu = "menu.png",
            imagen = "juego.png",
            dineroInicial = 0,
            tiempoInicial = 10,
            danoAlumno = 1
        )

        assert.that(alumnoPrueba.estaDentroDelMapa(game.at(0, 0)))
        assert.notThat(alumnoPrueba.estaDentroDelMapa(game.at(-1, 0)))
        assert.notThat(alumnoPrueba.estaDentroDelMapa(game.at(game.width(), 0)))
        assert.notThat(alumnoPrueba.estaDentroDelMapa(game.at(0, -1)))
        assert.notThat(alumnoPrueba.estaDentroDelMapa(game.at(0, game.height())))
    }
}