import alumno.*
import efectos.*
import interfaz.mostrables.*
import nivel1.consumibles.*
import nivel1.bondi.*
import nivel1.mobs.*

describe "Nuevos tests para Alumno" {
    test "El alumno aumenta su tiempo correctamente con agregarTiempo" {
        const tiempoAnterior = lucio.tiempo()
        lucio.agregarTiempo(20)
        assert.equals(tiempoAnterior + 20, lucio.tiempo())
    }

    test "El alumno aumenta y reduce su sueño correctamente dentro de los límites de 0 a 100" {
        lucio.reducirSueno(lucio.sueno())
        assert.equals(0, lucio.sueno())
        
        lucio.aumentarSueno(50)
        assert.equals(50, lucio.sueno())
        
        lucio.reducirSueno(80) // No debe bajar de 0
        assert.equals(0, lucio.sueno())

        lucio.aumentarSueno(150) // No debe superar 100
        assert.equals(100, lucio.sueno())
    }

    test "El saldo del alumno es 0 si no tiene SUBE y el saldo de su SUBE si la tiene asignada" {
        lucio.asignarSube(null)
        assert.equals(0, lucio.saldo())
        
        lucio.asignarSube(sube)
        sube.cargar(350)
        assert.equals(350, lucio.saldo())
    }

    test "El alumno consigue dinero incrementando correctamente su monto actual" {
        const dineroInicial = lucio.dinero()
        lucio.conseguirDinero(450)
        assert.equals(dineroInicial + 450, lucio.dinero())
    }

    test "El alumno tiene el daño configurado correctamente según el personaje elegido (lucio = 13)" {
        assert.equals(13, lucio.danoAlumno())
    }
}