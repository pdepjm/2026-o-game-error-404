import mostrables.*
import alumno.*
import consumibles.*
import bondi.*
import efectos.*
import mobs.*

describe "Alumno y sus Consumibles" {
    test "El alumno suma 100 de dinero al interactuar con un billete de 100" {
        assert.equals(0, pinguino.dinero())

        game.addVisual(billete100)
        
        billete100.interactuar(pinguino)
        
        assert.equals(100, pinguino.dinero())
        
    }

    test "El alumno agarra la SUBE y revisa que la tiene" {

        assert.notThat(lucio.tieneSube())

        sube.interactuar(lucio)

        assert.that(lucio.tieneSube())
    }

    test "Si no tiene saldo suficiente no puede subir al bondi" {
    assert.notThat(lucio.subirAlBondi())
    }

    test "Si tiene saldo suficiente puede subir al bondi" {
    lucio.conseguirSube(sube)
    lucio.conseguirDinero(10000)
    lucio.cargarSube(3000)
    assert.that(lucio.subirAlBondi())
    }



}

