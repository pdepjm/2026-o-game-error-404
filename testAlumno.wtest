import pantalla.*
import alumno.*
import consumibles.*
import bondi.*
import efectos.*
import mobs.*

describe "Alumno y sus Consumibles" {
    test "El alumno suma 100 de dinero al interactuar con un billete de 100" {
        assert.equals(0, alumno.dinero())

        game.addVisual(billete100)
        
        billete100.interactuar(alumno)
        
        assert.equals(100, alumno.dinero())
        
    }

    test "El alumno agarra la SUBE y revisa que la tiene" {

        assert.notThat(alumno.tieneSube())

        sube.interactuar(alumno)

        assert.that(alumno.tieneSube())
    }

    test "Si no tiene saldo suficiente no puede subir al bondi" {
    assert.notThat(alumno.subirAlBondi())
    }

    test "Si tiene saldo suficiente puede subir al bondi" {
    alumno.conseguirSube(sube)
    alumno.cargarSube(670)
    assert.that(alumno.subirAlBondi())
    }



}

