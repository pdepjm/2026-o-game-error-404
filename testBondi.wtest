import alumno.*
import consumibles.*
import bondi.*
import efectos.*
import mobs.*

describe "Bondi y su funcionamiento" {
    test "Cuando el tiempo llega a 0 el bondi spawnea" {
        alumno.tiempo(1)
        assert.notThat(alumno.llegoBondi())

        alumno.pasarSegundo()
        assert.that(alumno.llegoBondi())
        
    }
}