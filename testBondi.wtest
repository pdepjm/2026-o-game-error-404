import alumno.*
import consumibles.*
import bondi.*
import efectos.*
import mobs.*

describe "Bondi y su funcionamiento" {
    test "Cuando el tiempo llega a 0 el bondi spawnea" {
        lucio.tiempo(1)
        assert.notThat(lucio.llegoBondi())

        lucio.pasarSegundo()
        assert.that(lucio.llegoBondi())
        
    }
}