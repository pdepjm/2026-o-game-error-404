import wollok.game.*
import alumno.*
import interfaz.pantallas.*
import nivel1.nivel1.*
import nivel2.nivel2.*

program ElBondi {
    game.title("elBondi")
    game.height(15)
    game.width(30)

    game.addVisual(pantallaInicio)
    game.addVisual(previewPersonaje)

    keyboard.num1().onPressDo({
        juego.jugador(pinguino)
        previewPersonaje.image(pinguino.imagenMenu())
    })

    keyboard.num2().onPressDo({
        juego.jugador(lucio)
        previewPersonaje.image(lucio.imagenMenu())
    })

    keyboard.num3().onPressDo({
        juego.jugador(lari)
        previewPersonaje.image(lari.imagenMenu())
    })

      keyboard.num4().onPressDo({
        juego.jugador(solci)
        previewPersonaje.image(solci.imagenMenu())
    })

      keyboard.num5().onPressDo({
        juego.jugador(alvarez)
        previewPersonaje.image(alvarez.imagenMenu())
    })


    keyboard.enter().onPressDo({
        nivel1.iniciar()
    })

    game.start()
}