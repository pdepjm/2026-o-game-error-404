import wollok.game.*

import alumno.*
import efectos.*
import kiosco.*
import pantalla.*
import sube.*

program ElBondi {
	game.title("elJuegoDelBondi")
	game.height(15)
	game.width(15)

    game.addVisual(alumno)
    game.addVisual(reloj)
    game.addVisual(plata)
    game.addVisual(sube)
    game.addVisual(kiosco)


    keyboard.w().onPressDo({ 
        alumno.mover(alumno.position().up(1))
    })

    keyboard.s().onPressDo({ 
        alumno.mover(alumno.position().down(1))
    })

    keyboard.a().onPressDo({ 
        alumno.mover(alumno.position().left(1))
    })

    keyboard.d().onPressDo({ 
        alumno.mover
        (alumno.position().right(1))
    })

    game.onCollideDo(alumno, {objetoChocado => objetoChocado.interactuar(alumno)})
	game.start()
    
    
}