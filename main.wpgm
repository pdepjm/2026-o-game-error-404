import wollok.game.*

import alumno.*
import bondi.*
import consumibles.*
import efectos.*
import mobs.*
import mostrables.*
import pantallas.*

program ElBondi {
    game.title("elJuegoDelBondi")
    game.height(15)
    game.width(30)

    game.addVisual(pantallaInicio)

    keyboard.enter().onPressDo({
        game.removeVisual(pantallaInicio)
        game.addVisual(fondoMapa)

        game.addVisual(alumno)
        game.addVisual(reloj)
        game.addVisual(plata)
        game.addVisual(saldo)
        game.addVisual(sube)
        game.addVisual(kiosco)
        game.addVisual(fisura)
        game.addVisual(vecino)
        game.addVisual(policia)

        game.addVisual(billete100)
        game.addVisual(billete200)
        game.addVisual(billete500)
        game.addVisual(billete1000)

        keyboard.w().onPressDo({ alumno.mover(alumno.position().up(1)) })
        keyboard.s().onPressDo({ alumno.mover(alumno.position().down(1)) })
        keyboard.a().onPressDo({ alumno.mover(alumno.position().left(1)) })
        keyboard.d().onPressDo({ alumno.mover(alumno.position().right(1)) })

        game.onTick(150, "seMueveFisura", { fisura.moverse() })
        game.onTick(100, "seMuevePolicia", { policia.moverse() })

        game.onCollideDo(alumno, { objetoChocado => objetoChocado.interactuar(alumno) })
        game.onTick(1000, "relojJuego", { alumno.pasarSegundo() })

        // Visuales de los autos
        game.addVisual(autoRojo)
        game.addVisual(autoAzul)
        game.addVisual(autoVerde)
        game.addVisual(taxi)

        game.onTick(60, "mueveRojo", { autoRojo.moverse() })
        game.onTick(60, "mueveAzul", { autoAzul.moverse() })
        game.onTick(60, "mueveVerde", { autoVerde.moverse() })
        game.onTick(60, "mueveTaxi", { taxi.moverse() })
    })

    game.start()
}