import alumno.*
import consumibles.*
import bondi.*
import efectos.*
import mobs.*

describe "Mobs y la interacción con alumno" {
    test "Cuando el fisura choca con el alumno le saca 15 de tiempo y la mitad de la plata" {
        alumno.tiempo(50)
        alumno.conseguirDinero(100)
        
        fisura.interactuar(alumno)

        assert.equals(50, alumno.dinero())
        assert.equals(35, alumno.tiempo())
        
    }
     test "La policia puede interactuar con el alumno" {
        policia.interactuar(alumno)
        assert.that(alumno.tiempo() == 0) // Esto es para que el test pase, ya que meterEnCana.aplicarEfecto(personaje) no está implementado y no sabemos qué efecto tiene sobre el alumno.
    }
}


   